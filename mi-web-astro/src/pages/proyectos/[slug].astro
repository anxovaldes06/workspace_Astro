---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export const prerender = true;

export async function getStaticPaths() {
	const proyectos = await getCollection("proyectos");

	return proyectos.map((proyecto) => ({
		params: { slug: proyecto.id },
		props: { proyecto },
	}));
}

const { proyecto } = Astro.props;
const { Content } = await render(proyecto);
---

<Layout title={proyecto.data.titulo}>
	<main>
		<article>
			<h1>{proyecto.data.titulo}</h1>
			<p>Autor: {proyecto.data.autor}</p>
			<Content />
		</article>
	</main>
</Layout>

<style>
	main {
		box-sizing: border-box;
		width: min(100% - 2rem, 960px);
		min-height: calc(100svh - 70px);
		margin: 0 auto;
		padding: clamp(2rem, 7vh, 5rem) 0;
	}

	:global(body) {
		min-height: 100vh;
		background:
			radial-gradient(ellipse at 8% 15%, rgb(174 215 173 / 65%), transparent 30%),
			radial-gradient(ellipse at 92% 75%, rgb(197 224 178 / 55%), transparent 32%),
			linear-gradient(145deg, #eaf4e9, #cfe4d0 55%, #e6f0df);
	}

	article {
		position: relative;
		overflow: hidden;
		padding: clamp(1.5rem, 5vw, 3rem);
		border: 1px solid rgb(255 255 255 / 90%);
		border-radius: 1.75rem;
		background: linear-gradient(150deg, rgb(255 255 255 / 98%), rgb(248 252 247 / 96%));
		box-shadow: 0 28px 70px rgb(25 69 39 / 16%), 0 3px 12px rgb(25 69 39 / 5%);
	}

	article::before {
		position: absolute;
		top: 0;
		right: 0;
		left: 0;
		height: 0.45rem;
		background: linear-gradient(90deg, #2e7545, #8dbd78, #d4e9b5);
		content: "";
	}

	h1 {
		max-width: 20ch;
		margin: 0 0 1rem;
		color: #174b2c;
		font-size: clamp(2rem, 6vw, 3.5rem);
		font-weight: 800;
		letter-spacing: -0.045em;
		line-height: 1.1;
	}

	:global(article > p) {
		color: #4e6554;
		line-height: 1.7;
	}

	:global(article > p:first-of-type) {
		display: inline-flex;
		margin: 0 0 1.25rem;
		padding: 0.4rem 0.8rem;
		border: 1px solid #d9e9d9;
		border-radius: 999px;
		background: #eff7ed;
		color: #47734e;
		font-size: 0.9rem;
		font-weight: 650;
	}

	:global(article > p:nth-of-type(2)) {
		max-width: 68ch;
		margin: 0 0 1.5rem;
		font-size: clamp(1rem, 2vw, 1.12rem);
	}

	:global(article strong) {
		color: #285d39;
	}

	:global(.project-gallery) {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(0.75rem, 2vw, 1.25rem);
		margin: 1.75rem 0 2rem;
	}

	:global(.project-gallery img) {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 8 / 5;
		object-fit: cover;
		border: 1px solid #d3e4d3;
		border-radius: 1.15rem;
		background: #e8f2e7;
		box-shadow: 0 10px 24px rgb(35 77 47 / 10%);
		transition: transform 180ms ease, box-shadow 180ms ease;
	}

	:global(.project-gallery img:hover) {
		transform: translateY(-4px);
		box-shadow: 0 16px 30px rgb(35 77 47 / 16%);
	}

	:global(article a) {
		color: #17633a;
		font-weight: 700;
		text-underline-offset: 0.2em;
	}

	:global(article p:has(> strong) a) {
		display: inline-flex;
		align-items: center;
		margin: 0.5rem 0 0;
		padding: 0.75rem 1.1rem;
		border: 1px solid #286d41;
		border-radius: 999px;
		background: #286d41;
		color: #fff;
		text-decoration: none;
		transition: background-color 160ms ease, transform 160ms ease;
	}

	:global(article p:has(> strong) a:hover) {
		transform: translateY(-2px);
		background: #1e5734;
	}

	:global(article a:focus-visible) {
		outline: 3px solid #91bd78;
		outline-offset: 3px;
	}

	@media (max-width: 600px) {
		main {
			width: min(100% - 1.25rem, 960px);
			padding-block: 1.25rem;
		}

		:global(.project-gallery) {
			grid-template-columns: 1fr;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		:global(.project-gallery img),
		:global(article p:has(> strong) a) {
			transition: none;
		}
	}
</style>
