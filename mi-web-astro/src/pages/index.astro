---
import Button from "../components/Button.astro";
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";

const nombre = "Anxo";
const favoritos = ["Beber", "Dormir", "Comer"];
const valor = 20;
---

<Layout>
  <h1>Mi primera página de astro</h1>
  <p>Mi nombre es {nombre}</p>
  <ul>
  {favoritos.map((fav) => <li>{fav}</li>)}
  </ul>
  <p>Tengo {valor} años</p>
  <Button title="Tócame" />
  <Card titulo="El Chapo Guzmán" descripcion="Perro mafia hondureña" imagen="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQZJM4xNZ6C35n-1Aj9Lp01XjqcLT3mHtAkRdhhSR0kbtgbjs4McLB28m4&s=10" />
  </Layout>
