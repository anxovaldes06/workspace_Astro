---
import Layout from "../layouts/Layout.astro";
---

<Layout>
    <form id="newsletter">
        <label>Suscribete a mi boletin informático : </label>
        <input type="email" id="email" />
        <button type="submit">Subscribirse</button>
    </form>
</Layout>
<script>
    import { actions } from "astro:actions";
    const form = document.querySelector("#newsletter");
    form?.addEventListener("submit", guardarEmail);
    async function guardarEmail(event) {
        event.preventDefault();
         const {data,error} = await actions.newsletter({email : "prueba"})
        form.reset();
    }
</script>
