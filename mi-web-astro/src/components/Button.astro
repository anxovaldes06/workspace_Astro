---
const title = Astro.props.title
---

<button class="btn">{title}</button>
<style>
  .btn {
    background-color: rgb(35, 122, 6);
    color: rgb(0, 0, 0);
    padding: 10px 10px;
    border-radius: 8px;
    border-color: rgb(62, 216, 88);
  }
  .btn-hover {
    background-color: rgb(57, 226, 57);
  }
</style>
